# === Antigravity Headless Autentizace ===
# Volitelný Gemini API klíč (jinak se přihlaste přes Google OAuth přímo ve Web UI).
GEMINI_API_KEY=

# Chování Antigravity CLI (agy)
AGY_MODE=auto
AGY_DANGEROUSLY_SKIP_PERMISSIONS=true
AGY_TIMEOUT_SECONDS=300
# Trvale spuštěný (teplý) proces `agy --input-format stream-json --output-format stream-json`
AGY_PERSISTENT_SESSION=true
AGY_CLI_DISABLE_AUTO_UPDATE=true

# === Telegram Bot ===
# Token od @BotFather (pokud zůstane prázdný, poběží jen Web UI a API)
TELEGRAM_BOT_TOKEN=
# Povolená Telegram User ID oddělená čárkou (např. 123456789)
TELEGRAM_ALLOWED_USERS=
# Výchozí Telegram chat ID pro proaktivní zprávy (prázdné = první ID z TELEGRAM_ALLOWED_USERS)
TELEGRAM_NOTIFY_CHAT_ID=

# === Web UI & REST API ===
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Volitelný záložní Web Token (přihlášení heslem + 2FA si nastavíte přímo ve Web UI)
WEB_AUTH_TOKEN=

# === Plánovač & Noční úklid ===
TZ=Europe/Prague
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_MINUTES=60
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_CRON=0 8 * * *
NIGHTLY_RESET_ENABLED=true
NIGHTLY_RESET_CRON=15 0 * * *

# === Výchozí kontext asistenta ===
# auto | pracovni | osobni
DEFAULT_CONTEXT_MODE=auto

# === Volitelné vzdálené MCP servery (Streamable HTTP) ===
# Použijí se jen při prvním startu, pokud ještě neexistuje ~/.gemini/config/mcp_config.json.
# Další MCP servery lze kdykoli přidat ve Web UI (Nastavení → MCP servery).
MCP_PRACE_N8N_URL=
MCP_PRACE_N8N_TOKEN=
MCP_PRACE_NOCODB_URL=
MCP_PRACE_NOCODB_TOKEN=
MCP_OSOBNI_N8N_URL=
MCP_OSOBNI_N8N_TOKEN=
MCP_OSOBNI_NOCODB_URL=
MCP_OSOBNI_NOCODB_TOKEN=
MCP_OSOBNI_GOOGLE_URL=
MCP_OSOBNI_GOOGLE_TOKEN=
