# === Language & Identity ===
# Default UI and assistant language: en | cs | de | sk | es | pl
LANGUAGE=en
# Optional preset assistant name (empty = assistant asks you on first chat)
ASSISTANT_NAME=

# === Antigravity Headless Authentication ===
# Optional Gemini API key (otherwise sign in via Google OAuth in the Web UI).
GEMINI_API_KEY=

# Antigravity CLI (agy) behavior
AGY_MODE=auto
AGY_DANGEROUSLY_SKIP_PERMISSIONS=true
AGY_TIMEOUT_SECONDS=300
# Persistent warm process `agy --input-format stream-json --output-format stream-json`
AGY_PERSISTENT_SESSION=true
AGY_CLI_DISABLE_AUTO_UPDATE=true

# === Telegram Bot ===
# Token from @BotFather (if left empty, only Web UI and API will run)
TELEGRAM_BOT_TOKEN=
# Comma-separated allowed Telegram User IDs (e.g. 123456789)
TELEGRAM_ALLOWED_USERS=
# Default Telegram chat ID for proactive messages (empty = first ID from TELEGRAM_ALLOWED_USERS)
TELEGRAM_NOTIFY_CHAT_ID=

# === Web UI & REST API ===
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Optional backup Web Token (password + 2FA login can be set directly in Web UI)
WEB_AUTH_TOKEN=
# Optional URL to check for newer assistant releases (empty = disable check)
APP_VERSION_CHECK_URL=https://raw.githubusercontent.com/petrbla/agy-assistant/main/VERSION

# === Scheduler & Nightly Cleanup ===
TZ=Europe/Prague
HEARTBEAT_ENABLED=true
HEARTBEAT_INTERVAL_MINUTES=60
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_CRON=0 8 * * *
NIGHTLY_RESET_ENABLED=true
NIGHTLY_RESET_CRON=15 0 * * *
IDLE_RESET_ENABLED=true
IDLE_RESET_MINUTES=120
DAILY_MEMORY_RETENTION_DAYS=30
# Optional daily sanitized agent backup to a private GitHub repository
GITHUB_BACKUP_ENABLED=false
GITHUB_BACKUP_REPO=
GITHUB_BACKUP_BRANCH=main
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_CRON=30 2 * * *

# === Default Assistant Context ===
# auto | pracovni (work) | osobni (personal)
DEFAULT_CONTEXT_MODE=auto

# === Optional Remote MCP Servers (Streamable HTTP) ===
# Used only on initial startup if ~/.gemini/config/mcp_config.json does not exist yet.
# Additional MCP servers can be managed anytime in Web UI (Settings -> MCP Servers).
MCP_WORK_N8N_URL=
MCP_WORK_N8N_TOKEN=
MCP_WORK_NOCODB_URL=
MCP_WORK_NOCODB_TOKEN=
MCP_PERSONAL_N8N_URL=
MCP_PERSONAL_N8N_TOKEN=
MCP_PERSONAL_NOCODB_URL=
MCP_PERSONAL_NOCODB_TOKEN=
MCP_PERSONAL_GOOGLE_URL=
MCP_PERSONAL_GOOGLE_TOKEN=
# Legacy Czech aliases (also supported): MCP_PRACE_* / MCP_OSOBNI_*
